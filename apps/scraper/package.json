{
  "name": "@promo/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "scrape:once": "tsx src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --testTimeout=15000",
    "offers:blix": "node --env-file-if-exists=../../.env --max-http-header-size=65536 --import tsx src/offers-blix.ts"
  },
  "dependencies": {
    "@promo/shared": "0.1.0",
    "cheerio": "^1.0.0",
    "node-cron": "^4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/node-cron": "^3.0.11",
    "vitest": "^5.1.0"
  }
}
