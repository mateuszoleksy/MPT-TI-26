{
  "name": "@promo/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "scrape:once": "tsx src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@promo/shared": "0.1.0",
    "cheerio": "^1.0.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11"
  }
}
