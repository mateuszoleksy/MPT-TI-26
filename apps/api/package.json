{
  "name": "@promo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@promo/shared": "0.1.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
