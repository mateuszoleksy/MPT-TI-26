# Copy to .env and adjust
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo
POSTGRES_DB=promo
DATABASE_URL=postgres://promo:promo@localhost:5432/promo

API_PORT=3000
WEB_PORT=5173

# Scraper: cron expression (default: every day at 06:00) and the timezone it is evaluated in
SCRAPE_CRON=0 6 * * *
SCRAPE_TZ=Europe/Warsaw
