{
  "name": "mpt-ti-26",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build -w @promo/shared && npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @promo/api",
    "dev:web": "npm run dev -w @promo/web",
    "dev:scraper": "npm run dev -w @promo/scraper",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check .",
    "offers:blix": "npm run offers:blix -w @promo/scraper --",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/shared/src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
